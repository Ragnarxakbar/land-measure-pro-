    function getStr(key) { return dict[key] ? dict[key][lang] : key; }

    function setLang(l) {
        lang = l;
        document.getElementById('btn-lang-en').classList.toggle('active', l==='en');
        document.getElementById('btn-lang-bn').classList.toggle('active', l==='bn');
        
        document.querySelectorAll('[data-i18n]').forEach(el => {
            let key = el.getAttribute('data-i18n');
            if(dict[key]) {
                // If element has SVG icon inside, preserve it
                let svg = el.querySelector('svg');
                if(svg) {
                    el.innerHTML = '';
                    el.appendChild(svg);
                    el.appendChild(document.createTextNode(' ' + dict[key][lang]));
                } else {
                    el.innerText = dict[key][lang];
                }
            }
        });
        localStorage.setItem('landLang', l);
    }

    function setTheme(t) {
        document.getElementById('btn-theme-dark').classList.toggle('active', t==='dark');
        document.getElementById('btn-theme-light').classList.toggle('active', t==='light');
        if(t === 'light') document.body.classList.add('light-mode');
        else document.body.classList.remove('light-mode');
        localStorage.setItem('landTheme', t);
    }

    function clearHistory() {
        localStorage.removeItem('landHistory');
        renderHistory();
        showToast(getStr('cleared'));
    }

    // Init App
    window.onload = () => {
        let savedTheme = localStorage.getItem('landTheme') || 'dark';
        setTheme(savedTheme);
        
        let savedLang = localStorage.getItem('landLang') || 'en';
        setLang(savedLang);
        
        calcConverter(); // Init converter labels
    };

</script>
</body>
</html>


