<div id="toast" class="toast">Copied!</div>

<script>
    /* === GLOBAL STATE === */
    let currentModule = 'rect';
    let circMode = 'radius';
    let segMode = 'chord';
    let currentAreaSqFt = 0;
    let autoSaveTimer = null;

    /* === SMART INPUT: 3-Digit Auto Switch & Inch Conversion === */
    document.querySelectorAll('.ft-input').forEach(input => {
        input.addEventListener('input', function(e) {
            // Remove non-numeric characters (keep decimals if user pastes, but mostly numeric)
            this.value = this.value.replace(/[^0-9.]/g, '');
            
            // Limit to 3 digits unless backspacing
            if (this.value.includes('.')) return; // Don't auto-switch if they are typing decimals
            
            let valStr = this.value;
            // The requirement: "in ft section i cann add 3 digits then automatic switch to next"
            if (valStr.length === 3 && e.inputType !== 'deleteContentBackward') {
                let nextId = this.dataset.next;
                if(nextId) document.getElementById(nextId).focus();
            }
            triggerCalc();
        });
    });

    document.querySelectorAll('.in-input').forEach(input => {
        input.addEventListener('input', function(e) {
            this.value = this.value.replace(/[^0-9.]/g, '');
            let val = parseFloat(this.value);
            
            // "If inch becomes 12 or more automatically convert into feet"
            if (!isNaN(val) && val >= 12) {
                let prevId = this.dataset.prev;
                let ftInput = document.getElementById(prevId);
                if(ftInput) {
                    let currentFt = parseInt(ftInput.value || 0);
                    let extraFt = Math.floor(val / 12);
                    let remIn = val % 12;
                    
                    ftInput.value = currentFt + extraFt;
                    this.value = remIn === 0 ? '' : remIn;
                }
            }
            triggerCalc();
        });
    });

    // Converter specific normal inputs
    document.querySelectorAll('input:not(.ft-input):not(.in-input)').forEach(input => {
        input.addEventListener('input', triggerCalc);
    });

    /* === CORE MATH & LOGIC === */
    function parseDim(ftId, inId) {
        let ft = parseFloat(document.getElementById(ftId).value || 0);
        let inch = parseFloat(document.getElementById(inId).value || 0);
        return ft + (inch / 12);
    }

    function triggerCalc() {
        if(currentModule === 'rect') calcRect();
        else if(currentModule === 'tri') calcTri();
        else if(currentModule === 'circ') calcCirc();
        else if(currentModule === 'seg') calcSeg();
        // Converter handles its own live update via inline oninput
        
        // Auto Save trigger
        if(currentAreaSqFt > 0 && currentModule !== 'conv') {
            clearTimeout(autoSaveTimer);
            autoSaveTimer = setTimeout(() => saveHistory(), 2000);
        }
    }

    function calcRect() {
        let d1 = parseDim('r_d1_ft', 'r_d1_in');
        let d2 = parseDim('r_d2_ft', 'r_d2_in');
        let p1 = parseDim('r_p1_ft', 'r_p1_in');
        let p2 = parseDim('r_p2_ft', 'r_p2_in');
        
        let avgD = (d1 + d2) / 2;
        let avgP = (p1 + p2) / 2;
        let area = avgD * avgP;
        
        if (area > 0) {
            document.getElementById('extra_info').style.display = 'block';
            document.getElementById('extra_info').innerText = `Avg L: ${fmt(avgD)} ft | Avg W: ${fmt(avgP)} ft`;
        } else {
            document.getElementById('extra_info').style.display = 'none';
        }
        updateResults(area);
    }

    function calcTri() {
        let b = parseDim('t_b_ft', 't_b_in');
        let h = parseDim('t_h_ft', 't_h_in');
        let area = 0.5 * b * h;
        document.getElementById('extra_info').style.display = 'none';
        updateResults(area);
    }

    function calcCirc() {
        let r_val = parseDim('c_ft', 'c_in');
        let r = circMode === 'diameter' ? r_val / 2 : r_val;
        let area = Math.PI * r * r;
        let circ = 2 * Math.PI * r;
        
        if (area > 0) {
            document.getElementById('extra_info').style.display = 'block';
            document.getElementById('extra_info').innerText = `Circumference: ${fmt(circ)} ft`;
        } else {
            document.getElementById('extra_info').style.display = 'none';
        }
        updateResults(area);
    }

    function calcSeg() {
        let r = parseDim('s_r_ft', 's_r_in');
        let area = 0;
        if(r <= 0) { updateResults(0); return; }

        if(segMode === 'chord') {
            let c = parseDim('s_c_ft', 's_c_in');
            if (c > 0 && c <= 2*r) {
                let theta = 2 * Math.asin(c / (2*r)); // radians
                area = 0.5 * r * r * (theta - Math.sin(theta));
            }
        } else {
            let deg = parseFloat(document.getElementById('s_a').value || 0);
            if(deg > 0 && deg <= 360) {
                let theta = deg * (Math.PI / 180);
                area = 0.5 * r * r * (theta - Math.sin(theta));
            }
        }
        document.getElementById('extra_info').style.display = 'none';
        updateResults(area);
    }

    /* === UNIT CONVERSIONS (WB STANDARD) === */
    const CONST = {
        SQM: 0.092903,
        DECIMAL: 435.6,
        KATHA: 720,
        BIGHA: 14400,
        ACRE: 43560,
        HECTARE: 107639
    };

    function updateResults(sqft) {
        currentAreaSqFt = sqft;
        document.getElementById('res_sqft').innerText = fmt(sqft, 2);
        document.getElementById('res_sqm').innerText = fmt(sqft * CONST.SQM, 2);
        document.getElementById('res_dec').innerText = fmt(sqft / CONST.DECIMAL, 2);
        document.getElementById('res_katha').innerText = fmt(sqft / CONST.KATHA, 2);
        document.getElementById('res_bigha').innerText = fmt(sqft / CONST.BIGHA, 3);
        document.getElementById('res_acre').innerText = fmt(sqft / CONST.ACRE, 3);
        document.getElementById('res_hec').innerText = fmt(sqft / CONST.HECTARE, 4);
    }

    function fmt(num, dec = 2) {
        if(isNaN(num) || num === 0) return "0.00";
        return Number(num).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec });
    }

    /* === CONVERTER MODULE === */
    function calcConverter() {
        let type = document.getElementById('conv_type').value;
        let std = document.getElementById('conv_inputs_standard');
        let cpx = document.getElementById('conv_inputs_complex');
        let l1 = document.getElementById('lbl_conv_1');
        let l2 = document.getElementById('lbl_conv_2');
        
        let v1 = document.getElementById('cv_1');
        let v2 = document.getElementById('cv_2');
        v1.value = ''; v2.value = '';

        if(type === 'ftin_dec') {
            std.style.display = 'none';
            cpx.style.display = 'flex';
        } else {
            std.style.display = 'flex';
            cpx.style.display = 'none';
            let parts = type.split('_');
            l1.innerText = formatUnitName(parts[0]);
            l2.innerText = formatUnitName(parts[1]);
        }
    }

    function doConv(source) {
        let type = document.getElementById('conv_type').value;
        let v1 = document.getElementById('cv_1');
        let v2 = document.getElementById('cv_2');
        let val1 = parseFloat(v1.value);
        let val2 = parseFloat(v2.value);
        
        if(source === 1 && isNaN(val1)) { v2.value = ''; return; }
        if(source === 2 && isNaN(val2)) { v1.value = ''; return; }

        let multiplier = 1;
        switch(type) {
            case 'ft_in': multiplier = 12; break;
            case 'ft_m': multiplier = 0.3048; break;
            case 'ft_cm': multiplier = 30.48; break;
            case 'sqft_sqm': multiplier = CONST.SQM; break;
            case 'sqft_acre': multiplier = 1/CONST.ACRE; break;
            case 'sqft_dec': multiplier = 1/CONST.DECIMAL; break;
            case 'sqft_katha': multiplier = 1/CONST.KATHA; break;
            case 'sqft_bigha': multiplier = 1/CONST.BIGHA; break;
            case 'sqft_hec': multiplier = 1/CONST.HECTARE; break;
            case 'dec_katha': multiplier = CONST.DECIMAL/CONST.KATHA; break;
            case 'dec_acre': multiplier = 1/100; break;
            case 'bigha_katha': multiplier = 20; break;
        }

        if(source === 1) v2.value = (val1 * multiplier).toFixed(4).replace(/\.0000$/, '');
        else v1.value = (val2 / multiplier).toFixed(4).replace(/\.0000$/, '');
    }

    function doConvComplex(source) {
        let ftInp = document.getElementById('cv_c_ft');
        let inInp = document.getElementById('cv_c_in');
        let decInp = document.getElementById('cv_c_dec');
        
        if (source === 1) {
            let f = parseFloat(ftInp.value || 0);
            let i = parseFloat(inInp.value || 0);
            let d = f + (i/12);
            if(f===0 && i===0) decInp.value = '';
            else decInp.value = d.toFixed(4);
        } else {
            let d = parseFloat(decInp.value);
            if(isNaN(d)) { ftInp.value = ''; inInp.value = ''; return; }
            let f = Math.floor(d);
            let i = (d - f) * 12;
            ftInp.value = f;
            inInp.value = i.toFixed(2).replace(/\.00$/, '');
        }
    }

    function formatUnitName(u) {
        const names = { ft: "Feet", in: "Inch", m: "Meter", cm: "Centimeter", sqft: "Sq.Ft", sqm: "Sq.M", acre: "Acre", dec: "Decimal", katha: "Katha", bigha: "Bigha", hec: "Hectare" };
        return names[u] || u;
    }

    /* === UI & INTERACTIONS === */
    function switchModule(mod, el) {
        currentModule = mod;
        document.querySelectorAll('.module').forEach(m => m.classList.remove('active'));
        document.getElementById('mod-' + mod).classList.add('active');
        
        document.querySelectorAll('.nav-pill').forEach(p => p.classList.remove('active'));
        el.classList.add('active');
        
        let rs = document.getElementById('result-section');
        if(mod === 'conv') {
            rs.style.display = 'none';
            calcConverter();
        } else {
            rs.style.display = 'block';
            triggerCalc();
        }
    }

    function setCircleMode(mode, el) {
        circMode = mode;
        Array.from(el.parentElement.children).forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        document.getElementById('lbl_circ_mode').innerText = mode === 'radius' ? getStr('radius') : getStr('diameter');
        triggerCalc();
    }

    function setSegMode(mode, el) {
        segMode = mode;
        Array.from(el.parentElement.children).forEach(c => c.classList.remove('active'));
        el.classList.add('active');
        
        if(mode === 'chord') {
            document.getElementById('seg_chord_grp').style.display = 'flex';
            document.getElementById('seg_angle_grp').style.display = 'none';
        } else {
            document.getElementById('seg_chord_grp').style.display = 'none';
            document.getElementById('seg_angle_grp').style.display = 'flex';
        }
        triggerCalc();
    }

    function clearCurrent() {
        let activeMod = document.getElementById('mod-' + currentModule);
        activeMod.querySelectorAll('input').forEach(inp => inp.value = '');
        triggerCalc();
        showToast(getStr('cleared'));
    }

    function showToast(msg) {
        let t = document.getElementById('toast');
        t.innerText = msg;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2000);
    }

    /* === TOOLS (Copy, Share, Save) === */
    function getResultString() {
        let sqft = document.getElementById('res_sqft').innerText;
        let dec = document.getElementById('res_dec').innerText;
        let katha = document.getElementById('res_katha').innerText;
        let bigha = document.getElementById('res_bigha').innerText;
        return `Land Measure Pro Result:\nArea: ${sqft} Sq.Ft\nDecimal: ${dec}\nKatha: ${katha}\nBigha: ${bigha}`;
    }

    function copyResult() {
        if(currentAreaSqFt === 0) return;
        let text = getResultString();
        navigator.clipboard.writeText(text).then(() => showToast(getStr('copied')));
    }

    function copyUPI() {
        navigator.clipboard.writeText("akbarverse@ptaxis").then(() => showToast("UPI ID Copied!"));
    }

    function shareResult() {
        if(currentAreaSqFt === 0) return;
        if (navigator.share) {
            navigator.share({
                title: 'Land Measure Pro',
                text: getResultString()
            }).catch(console.error);
        } else {
            copyResult();
        }
    }

    function saveHistory() {
        if(currentAreaSqFt === 0) return;
        let history = JSON.parse(localStorage.getItem('landHistory') || '[]');
        let title = currentModule.charAt(0).toUpperCase() + currentModule.slice(1) + " Calc";
        let date = new Date().toLocaleString();
        
        let item = { id: Date.now(), title, date, sqft: currentAreaSqFt };
        history.unshift(item);
        if(history.length > 20) history.pop();
        localStorage.setItem('landHistory', JSON.stringify(history));
        renderHistory();
    }

    function renderHistory() {
        let history = JSON.parse(localStorage.getItem('landHistory') || '[]');
        let list = document.getElementById('history-list');
        if(history.length === 0) {
            list.innerHTML = `<p style="text-align:center; color:var(--text-muted);" data-i18n="no_history">${getStr('no_history')}</p>`;
            return;
        }
        
        list.innerHTML = history.map(h => `
            <div class="history-item">
                <div class="history-title">${h.title} - ${fmt(h.sqft)} Sq.Ft</div>
                <div class="history-detail">${h.date}</div>
            </div>
        `).join('');
    }

    /* === MODALS === */
    function openSettings() { document.getElementById('modal-settings').classList.add('active'); }
    function openHistory() { renderHistory(); document.getElementById('modal-history').classList.add('active'); }
    function closeModal(e, id) { if(e.target.id === id) document.getElementById(id).classList.remove('active'); }
    function closeModalForce(id) { document.getElementById(id).classList.remove('active'); }

    /* === SETTINGS (Theme & Lang) === */
    let lang = 'en';
    const dict = {
