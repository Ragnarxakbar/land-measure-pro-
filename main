                        <div class="input-wrapper"><input type="number" inputmode="decimal" id="cv_1" oninput="doConv(1)" placeholder="0"></div>
                    </div>
                    <div class="input-group">
                        <label id="lbl_conv_2">Value 2</label>
                        <div class="input-wrapper"><input type="number" inputmode="decimal" id="cv_2" oninput="doConv(2)" placeholder="0"></div>
                    </div>
                </div>

                <div class="input-row" id="conv_inputs_complex" style="display:none;">
                     <div class="input-group">
                        <label>Feet</label>
                        <div class="input-wrapper"><input type="number" inputmode="decimal" id="cv_c_ft" class="ft-input" data-next="cv_c_in" oninput="doConvComplex(1)" placeholder="0"><span>ft</span></div>
                    </div>
                    <div class="input-group">
                        <label>Inch</label>
                        <div class="input-wrapper"><input type="number" inputmode="decimal" id="cv_c_in" class="in-input" data-prev="cv_c_ft" oninput="doConvComplex(1)" placeholder="0"><span>in</span></div>
                    </div>
                    <div class="input-group">
                        <label>Decimal Feet</label>
                        <div class="input-wrapper"><input type="number" inputmode="decimal" id="cv_c_dec" oninput="doConvComplex(2)" placeholder="0"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- GLOBAL RESULTS CARD (Hidden for Converter) -->
        <div id="result-section" class="card result-card">
            <div class="result-main">
                <p data-i18n="res_area">Total Area (Sq.Ft)</p>
                <h2 id="res_sqft">0.00</h2>
                <div id="extra_info" style="font-size:12px; color:var(--text-muted); margin-top:5px; display:none;"></div>
            </div>
            <div class="result-grid">
                <div class="result-item"><span class="label" data-i18n="res_dec">Decimal (Shotok)</span><span class="val" id="res_dec">0.00</span></div>
                <div class="result-item"><span class="label" data-i18n="res_katha">Katha</span><span class="val" id="res_katha">0.00</span></div>
                <div class="result-item"><span class="label" data-i18n="res_bigha">Bigha</span><span class="val" id="res_bigha">0.00</span></div>
                <div class="result-item"><span class="label" data-i18n="res_acre">Acre</span><span class="val" id="res_acre">0.000</span></div>
                <div class="result-item"><span class="label" data-i18n="res_hec">Hectare</span><span class="val" id="res_hec">0.0000</span></div>
                <div class="result-item"><span class="label" data-i18n="res_sqm">Sq. Meter</span><span class="val" id="res_sqm">0.00</span></div>
            </div>
            <div class="action-row">
                <button class="btn btn-outline" onclick="clearCurrent()"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg> <span data-i18n="btn_clear">Clear</span></button>
                <button class="btn btn-primary" onclick="copyResult()"><svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M16 1H4C2.9 1 2 1.9 2 3v14h2V3h12V1zm3 4H8C6.9 5 6 5.9 6 7v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg> <span data-i18n="btn_copy">Copy</span></button>
            </div>
        </div>

    </main>

    <!-- FLOATING TOOLS -->
    <div class="fab-container">
        <div class="fab-menu">
            <button class="fab-sub" onclick="openHistory()" title="History"><svg viewBox="0 0 24 24"><path d="M13 3a9 9 0 0 0-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42C8.27 19.99 10.51 21 13 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/></svg></button>
            <button class="fab-sub" onclick="shareResult()" title="Share"><svg viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg></button>
            <button class="fab-sub" onclick="window.print()" title="Print/PDF"><svg viewBox="0 0 24 24"><path d="M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z"/></svg></button>
        </div>
        <button class="fab">
            <svg viewBox="0 0 24 24"><path d="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.5 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/></svg>
        </button>
    </div>

